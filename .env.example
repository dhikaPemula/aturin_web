# =====================================================
# ATURIN WEB - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================
# Copy this file to .env and fill in your actual values
# This file is safe to commit to version control

# =====================================================
# API CONFIGURATION
# =====================================================
VITE_API_BASE_URL=https://aturin-app.com/api/v1
VITE_API_KEY=your_api_key_here

# =====================================================
# APPLICATION CONFIGURATION  
# =====================================================
VITE_APP_NAME=Aturin Web
VITE_APP_VERSION=0.0.0
VITE_APP_ENV=development

# =====================================================
# DEVELOPMENT CONFIGURATION
# =====================================================
VITE_DEV_MODE=true
VITE_DEBUG=true
VITE_HMR=true

# =====================================================
# DEPLOYMENT CONFIGURATION
# =====================================================
# VITE_PROD_API_URL=https://api.aturin.com/v1
# VITE_ANALYTICS_ID=your_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn

# =====================================================
# FEATURE FLAGS
# =====================================================
VITE_FEATURE_NOTIFICATIONS=true
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_BETA=false
